from typing import Any, Callable, Dict, Iterable, List, Mapping, MutableMapping, Optional, Sequence, Tuple, Type, TypeVar, Union

_F = TypeVar("_F", bound=Callable[..., Any])
_C = TypeVar("_C", bound=type)
_Input = Union[Iterable[Any], Callable[[], Iterable[Any]]]
_NameFunc = Callable[[Callable[..., Any], str, "param"], str]
_DocFunc = Callable[[Callable[..., Any], int, "param"], Optional[str]]

class param(Tuple[Any, ...]):
    args: Tuple[Any, ...]
    kwargs: Dict[str, Any]
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    @classmethod
    def explicit(cls, args: Optional[Sequence[Any]] = ..., kwargs: Optional[Mapping[str, Any]] = ...) -> param: ...
    @classmethod
    def from_decorator(cls, args: Any) -> param: ...

class parameterized:
    def __init__(self, input: _Input, doc_func: Optional[_DocFunc] = ..., skip_on_empty: bool = ...) -> None: ...
    def __call__(self, test_func: _F) -> Callable[..., Any]: ...
    @classmethod
    def expand(cls, input: _Input, name_func: Optional[_NameFunc] = ..., doc_func: Optional[_DocFunc] = ..., skip_on_empty: bool = ..., namespace: Optional[MutableMapping[str, Any]] = ..., decorators: Optional[Iterable[Callable[[Callable[..., Any]], Callable[..., Any]]]] = ..., **legacy: Any) -> Callable[[_F], Optional[_F]]: ...
    @classmethod
    def input_as_callable(cls, input: _Input) -> Callable[[], List[param]]: ...
    @classmethod
    def check_input_values(cls, input_values: Iterable[Any]) -> List[param]: ...
    @classmethod
    def param_as_standalone_func(cls, p: param, func: Callable[..., Any], name: str) -> Callable[..., Any]: ...
    @classmethod
    def to_safe_name(cls, s: Any) -> str: ...

def parameterized_class(attrs: Union[str, Sequence[str], Iterable[Mapping[str, Any]]], input_values: Optional[Iterable[Sequence[Any]]] = ..., class_name_func: Optional[Callable[[Type[Any], int, Mapping[str, Any]], str]] = ..., classname_func: Optional[Callable[[Type[Any], int, Iterable[Mapping[str, Any]]], str]] = ..., test_method_prefix: str = ...) -> Callable[[_C], _C]: ...
def default_doc_func(func: Callable[..., Any], num: int, p: param) -> Optional[str]: ...
def default_name_func(func: Callable[..., Any], num: Union[int, str], p: param) -> str: ...
def default_class_name_func(cls: Type[Any], num: int, params_dict: Mapping[str, Any]) -> str: ...
def get_class_name_suffix(params_dict: Mapping[str, Any]) -> str: ...
def short_repr(x: Any, n: int = ...) -> str: ...
def set_test_runner(name: str) -> None: ...
def detect_runner() -> str: ...

def parameterized_argument_value_pairs(func: Callable[..., Any], p: param) -> List[Tuple[str, Any]]: ...
def to_text(x: Any) -> str: ...
def getargspec(func: Callable[..., Any]) -> Any: ...
def skip_on_empty_helper(*a: Any, **kw: Any) -> None: ...
def reapply_patches_if_need(func: _F) -> _F: ...
def delete_patches_if_need(func: Callable[..., Any]) -> None: ...
PY2: bool
PY3: bool
SkipTest: Type[Exception]
